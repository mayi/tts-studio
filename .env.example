# ── LLM 分段配置 ─────────────────────────────────────────────
# LLM API 基地址（支持任何兼容 OpenAI 格式的端点）
# 例如: https://api.openai.com/v1 或 https://dashscope.aliyuncs.com/compatible-mode/v1 等
LLM_API_BASE=https://api.openai.com/v1

# LLM API 密钥
LLM_API_KEY=sk-your-api-key-here

# 使用的模型名称（例如: gpt-4o-mini, qwen-turbo, claude-3-5-sonnet 等）
LLM_MODEL=gpt-4o-mini

# ── ComfyUI 配置 ─────────────────────────────────────────────
# ComfyUI API 服务地址
COMFYUI_URL=http://127.0.0.1:8188

# ── 音频与切分参数 ───────────────────────────────────────────
# 每段最大字数
MAX_SEGMENT_CHARS=200

# 合成音频时每段之间的静音停顿时间（秒）
PAUSE_DURATION=1.0

# 轮询 ComfyUI 生成进度的间隔时间（秒）
POLL_INTERVAL=3

# 单段语音生成的超时时间（秒）
TIMEOUT=180

